(defmacro iys/define-theme (name)
  "声明主题 NAME 并应用 `iys/theme-palettes' 里的调色板。"
  `(progn
     (deftheme ,name)
     (iys/theme--apply ',name (alist-get ',name iys/theme-palettes))))


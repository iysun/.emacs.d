(defun iys/theme--apply (theme palette)
  "把 PALETTE 应用到 THEME 的 face 表。"
  (let ((bg (alist-get 'bg palette))
      (fg (alist-get 'fg palette))
      (bright (alist-get 'bright palette))
      (dim (alist-get 'dim palette))
      (secondary (alist-get 'secondary palette))
      (hl-line-bg (alist-get 'hl-line-bg palette))
      (tertiary (alist-get 'tertiary palette))
      (quaternary (alist-get 'quaternary palette))
      (pink (alist-get 'pink palette))
      (red (alist-get 'red palette))
      (orange (alist-get 'orange palette))
      (yellow (alist-get 'yellow palette))
      (green (alist-get 'green palette))
      (teal (alist-get 'teal palette))
      (blue (alist-get 'blue palette))
      (purple (alist-get 'purple palette))
      (gold (alist-get 'gold palette))
      (red-dark (alist-get 'red-dark palette))
      (red-deep (alist-get 'red-deep palette))
      (yellow-dark (alist-get 'yellow-dark palette))
      (green-dark (alist-get 'green-dark palette))
      (green-deep (alist-get 'green-deep palette))
      (blue-muted (alist-get 'blue-muted palette))
      (purple-muted (alist-get 'purple-muted palette)))
    (custom-theme-set-faces
     theme
     `(default        ((t :background ,bg :foreground ,fg)))
     `(success        ((t :foreground ,green :bold t)))
     `(warning        ((t :foreground ,yellow-dark)))
     `(error          ((t :foreground ,red-dark)))
     `(match          ((t :background ,red :foreground ,red-deep :bold t)))
     `(shadow         ((t :foreground ,bright)))
     `(border         ((t :background ,pink)))
     `(highlight      ((t :background ,secondary)))
     `(lazy-highlight ((t :inherit highlight)))
     `(region         ((t :inherit highlight)))
     `(hl-line        ((t :background ,hl-line-bg)))
  
     `(vertical-border            ((t :foreground ,secondary)))
     `(window-divider             ((t :inherit vertical-border)))
     `(window-divider-first-pixel ((t :inherit window-divider)))
     `(window-divider-last-pixel  ((t :inherit window-divider)))
  
     `(delete-selection-replacement ((t :inherit nil)))
     `(child-frame-border           ((t :inherit border)))
  
     `(fringe                 ((t :background ,bg)))
     `(secondary-selection    ((t :background ,secondary :foreground ,fg)))
